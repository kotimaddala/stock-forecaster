# Copy to .env and fill in. Never commit .env.

# Required for live model calls (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Analyst generates explanations; Reviewer judges them on a different, stronger model.
ANALYST_MODEL=openai/gpt-4o-mini
REVIEWER_MODEL=anthropic/claude-sonnet-4.5
RESEARCHER_MODEL=openai/gpt-4o-mini

# Required by the SEC for EDGAR access: your name and a contact email
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: Alpaca paper trading (https://alpaca.markets). Without these, orders go to a dry-run log.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Where the cache and journal are stored
FORECASTER_DATA_DIR=data
